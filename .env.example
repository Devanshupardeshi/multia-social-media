# Copy this file to .env and fill in your Instagram Graph API details.
#
# The access token should belong to the Facebook/Instagram app user with access
# to the Instagram professional account you want to monitor.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Keep this configurable because Meta Graph API versions move over time.
GRAPH_API_VERSION=v23.0

# auto detects most tokens. Use instagram for tokens generated from the Instagram setup screen,
# or facebook for Facebook Login/System User tokens.
INSTAGRAM_API_MODE=auto

# Dashboard server settings.
PORT=4173
DASHBOARD_REFRESH_MS=60000

# --- Sign-in ------------------------------------------------------------------
# The admin login. There is no default password: leave ADMIN_PASSWORD empty and
# admin login is disabled. Changing it signs the admin out everywhere.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Signs the session cookies. Required on Vercel; must stay the same across deploys
# (changing it signs everyone out). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Encrypts stored access tokens (AES-256-GCM). Strongly recommended in production.
# 32 random bytes, base64. LOSING THIS KEY MEANS RE-ENTERING EVERY TOKEN. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
